//aqui cria tipo um endpoint para receber os logs das aplicações
otelcol.receiver.otlp "main_receiver" {

  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs    = [otelcol.processor.batch.configuration_batch.input]
    metrics = [otelcol.processor.batch.configuration_batch.input]
    traces  = [otelcol.processor.batch.configuration_batch.input]
  }
}

//aqui faz o processamentos dos logs
//acada 5s e lotes de no maximo 1024 de tamahos
otelcol.processor.batch "configuration_batch" {

  timeout         = "5s"
  send_batch_size = 1024

  output {
    logs    = [otelcol.exporter.loki.convert_otlp_to_loki.input]
    traces  = [otelcol.exporter.otlp.send_to_tempo.input]
    metrics = [otelcol.exporter.prometheus.convert_otlp_to_prometheus.input]
  }
}


//aqui converte os arquiovos de opentelemetry para loki
//por que o loki não reconheceo OTLP/gRPC apenas o http
otelcol.exporter.loki "convert_otlp_to_loki" {

  forward_to = [loki.write.send_to_loki.receiver]
}


//aqui manda os traces para esse endereço ou conainter
//aqui precisa ser gRPC por que ele reconhece o protocolo OTLP/gRPC
otelcol.exporter.otlp "send_to_tempo" {

  client {

    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}


// Envia pro Loki nesse endereço ou container
// aqui reconhece apeas o HTTP
loki.write "send_to_loki" {

  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}


//aqui manda os traces para esse endereço ou conainter
//aqui precisa ser gRPC por que ele reconhece o protocolo OTLP/gRPC
otelcol.exporter.prometheus "convert_otlp_to_prometheus" {

  forward_to = [prometheus.remote_write.send_to_prometheus.receiver]
}

// Envia pro Loki nesse endereço ou container
// aqui reconhece apeas o HTTP
prometheus.remote_write "send_to_prometheus" {

  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}


//flow 
//Application
//   ↓
//OpenTelemetry Logs
//   ↓
//Alloy Receiver
//   ↓
//Loki Exporter
//   ↓
//loki.write
//   ↓
//HTTP POST /loki/api/v1/push
//   ↓
//Loki